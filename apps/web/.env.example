PUBLIC_API_BASE_URL=http://localhost:4000/v1
AMANOR_DEPLOYMENT_ENV=local
PUBLIC_WEB_BASE_URL=http://localhost:3000
REVALIDATION_WEBHOOK_KEYS={"revalidation-2026-08":"replace-with-at-least-32-random-bytes"}
REVALIDATION_AUDIENCE=amanor-public-web
PUBLIC_SERVICE_KEY_ID=web-2026-08
PUBLIC_SERVICE_SECRET=replace-with-at-least-32-random-bytes
