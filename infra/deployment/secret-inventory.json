{
  "schemaVersion": 1,
  "custodyPolicy": {
    "sourceControlAllowed": false,
    "frontendBuildSecretsAllowed": false,
    "providerSecretManagerRequired": true,
    "environmentIsolationRequired": true,
    "workloadIdentityPreferred": true,
    "evidenceMayContainValues": false
  },
  "deployables": {
    "web": {
      "secretClasses": [
        "public_service_signing",
        "revalidation_verification",
        "analytics_provider"
      ],
      "publicBuildVariables": [
        "NEXT_PUBLIC_ROOM_TRUST_ANCHOR_KEY_ID",
        "NEXT_PUBLIC_ROOM_TRUST_ANCHOR_PUBLIC_KEY"
      ]
    },
    "admin": {
      "secretClasses": [],
      "publicBuildVariables": [
        "NEXT_PUBLIC_AMANOR_DEPLOYMENT_ENV",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "api": {
      "secretClasses": [
        "mongodb_application",
        "mongodb_migration",
        "mongodb_retention",
        "mongodb_room",
        "jwt_signing",
        "session_pepper",
        "mfa_encryption",
        "public_service_verification",
        "revalidation_signing",
        "cloudinary",
        "cloudinary_retention",
        "email_provider",
        "calendar_provider",
        "metrics_access",
        "telemetry_export",
        "webauthn_relying_party"
      ],
      "publicBuildVariables": []
    }
  },
  "classes": {
    "public_service_signing": {
      "consumer": "web",
      "phase": "runtime",
      "required": "production",
      "variables": ["PUBLIC_SERVICE_KEY_ID", "PUBLIC_SERVICE_SECRET"],
      "secretVariables": ["PUBLIC_SERVICE_SECRET"],
      "rotation": "key-ring-overlap"
    },
    "revalidation_verification": {
      "consumer": "web",
      "phase": "runtime",
      "required": "production",
      "variables": ["REVALIDATION_WEBHOOK_KEYS", "REVALIDATION_AUDIENCE"],
      "secretVariables": ["REVALIDATION_WEBHOOK_KEYS"],
      "rotation": "key-ring-overlap"
    },
    "analytics_provider": {
      "consumer": "web",
      "phase": "runtime",
      "required": "when-enabled",
      "variables": ["ANALYTICS_EVENT_ENDPOINT", "ANALYTICS_SITE_ID"],
      "secretVariables": [],
      "rotation": "provider-config"
    },
    "mongodb_application": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["MONGODB_URI"],
      "secretVariables": ["MONGODB_URI"],
      "rotation": "dual-credential"
    },
    "mongodb_migration": {
      "consumer": "api",
      "phase": "migration-job",
      "required": "release-job",
      "variables": ["MONGODB_MIGRATION_URI"],
      "secretVariables": ["MONGODB_MIGRATION_URI"],
      "rotation": "job-scoped-credential"
    },
    "mongodb_retention": {
      "consumer": "api",
      "phase": "retention-job",
      "required": "scheduled-job",
      "variables": ["MONGODB_RETENTION_URI"],
      "secretVariables": ["MONGODB_RETENTION_URI"],
      "rotation": "job-scoped-credential"
    },
    "mongodb_room": {
      "consumer": "api",
      "phase": "runtime",
      "required": "when-room-enabled",
      "variables": ["ROOM_MONGODB_URI"],
      "secretVariables": ["ROOM_MONGODB_URI"],
      "rotation": "dual-credential"
    },
    "jwt_signing": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": [
        "JWT_KEY_ID",
        "JWT_PRIVATE_KEY_PEM",
        "JWT_PUBLIC_KEY_PEM",
        "JWT_VERIFICATION_KEYS"
      ],
      "secretVariables": ["JWT_PRIVATE_KEY_PEM"],
      "rotation": "bounded-signing-key-overlap"
    },
    "session_pepper": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["SESSION_PEPPER", "SESSION_RETIRING_PEPPERS"],
      "secretVariables": ["SESSION_PEPPER", "SESSION_RETIRING_PEPPERS"],
      "rotation": "bounded-pepper-overlap"
    },
    "mfa_encryption": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["MFA_ENCRYPTION_KEY", "MFA_RETIRING_ENCRYPTION_KEYS"],
      "secretVariables": ["MFA_ENCRYPTION_KEY", "MFA_RETIRING_ENCRYPTION_KEYS"],
      "rotation": "authenticated-reencryption"
    },
    "public_service_verification": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["PUBLIC_WEB_SERVICE_KEYS", "PUBLIC_WEB_SERVICE_AUDIENCE"],
      "secretVariables": ["PUBLIC_WEB_SERVICE_KEYS"],
      "rotation": "key-ring-overlap"
    },
    "revalidation_signing": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": [
        "REVALIDATION_WEBHOOK_KEYS",
        "REVALIDATION_ACTIVE_KEY_ID",
        "REVALIDATION_AUDIENCE"
      ],
      "secretVariables": ["REVALIDATION_WEBHOOK_KEYS"],
      "rotation": "key-ring-overlap"
    },
    "cloudinary": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": [
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET"
      ],
      "secretVariables": ["CLOUDINARY_API_SECRET"],
      "rotation": "dual-credential"
    },
    "cloudinary_retention": {
      "consumer": "api",
      "phase": "retention-job",
      "required": "scheduled-job",
      "variables": [
        "CLOUDINARY_RETENTION_CLOUD_NAME",
        "CLOUDINARY_RETENTION_API_KEY",
        "CLOUDINARY_RETENTION_API_SECRET"
      ],
      "secretVariables": [
        "CLOUDINARY_RETENTION_API_KEY",
        "CLOUDINARY_RETENTION_API_SECRET"
      ],
      "rotation": "job-scoped-credential"
    },
    "email_provider": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": [
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "PROTOCOL_DECISION_DERIVATION_KEY",
        "PRESS_CONTACT_EMAIL",
        "GENERAL_CONTACT_EMAIL"
      ],
      "secretVariables": ["RESEND_API_KEY", "PROTOCOL_DECISION_DERIVATION_KEY"],
      "rotation": "dual-credential"
    },
    "calendar_provider": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["CALENDAR_API_URL", "CALENDAR_API_TOKEN", "CALENDAR_ID"],
      "secretVariables": ["CALENDAR_API_TOKEN"],
      "rotation": "dual-credential"
    },
    "metrics_access": {
      "consumer": "api",
      "phase": "runtime",
      "required": "production",
      "variables": ["METRICS_BEARER_TOKEN"],
      "secretVariables": ["METRICS_BEARER_TOKEN"],
      "rotation": "dual-credential"
    },
    "telemetry_export": {
      "consumer": "api",
      "phase": "runtime",
      "required": "when-enabled",
      "variables": [
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
        "OTEL_TRACE_SAMPLE_RATIO"
      ],
      "secretVariables": [],
      "rotation": "provider-config"
    },
    "webauthn_relying_party": {
      "consumer": "api",
      "phase": "runtime",
      "required": "when-enabled",
      "variables": [
        "WEBAUTHN_ENABLED",
        "WEBAUTHN_RP_ID",
        "WEBAUTHN_RP_NAME",
        "WEBAUTHN_ORIGIN"
      ],
      "secretVariables": [],
      "rotation": "provider-config"
    }
  }
}
