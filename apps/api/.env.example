NODE_ENV=development
PORT=4000
ADMIN_ORIGIN=http://localhost:3001
PUBLIC_WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/project_amanor
RUN_MIGRATIONS=true
# Keep disabled until the separately reviewed Room module is deployed. When
# enabled, this URI must name a different database and database user from
# MONGODB_URI; the application credential must have no grants on that database.
ROOM_ENABLED=false
ROOM_MONGODB_URI=
# The trust anchor whose public half is pinned in the public web bundle. The
# API only verifies with it; the private half stays in offline dual-control
# custody and signs manifests through scripts/publish-room-manifest.mjs.
ROOM_TRUST_ANCHOR_KEY_ID=
ROOM_TRUST_ANCHOR_PUBLIC_KEY=
# Authentication factors every Room operator must present, comma separated.
# Defaults to hwk, which the platform cannot issue until AMANOR-116 delivers
# hardware-key MFA, so Room access stays closed unless this is set explicitly.
ROOM_REQUIRED_AMR=
# One-shot release jobs use a separate privileged secret:
MONGODB_MIGRATION_URI=
# Daily one-shot retention jobs use a distinct least-privilege secret:
MONGODB_RETENTION_URI=
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=amanor-admin
JWT_KEY_ID=local-development-key
JWT_PRIVATE_KEY_PEM=replace-with-an-es256-pkcs8-private-key
JWT_PUBLIC_KEY_PEM=replace-with-the-matching-es256-spki-public-key
# Active plus retiring public keys. Keep a retiring key only for the five-minute access-token lifetime.
JWT_VERIFICATION_KEYS={"local-development-key":"replace-with-the-matching-es256-spki-public-key"}
SESSION_PEPPER=replace-with-at-least-32-random-bytes
# Prior peppers accepted only during a bounded refresh-session/invitation drain window.
SESSION_RETIRING_PEPPERS=[]
MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
# Prior AES-256-GCM keys accepted only during a bounded authenticated migration window.
MFA_RETIRING_ENCRYPTION_KEYS=[]
WEB_REVALIDATION_URL=http://localhost:3000/api/revalidate
REVALIDATION_WEBHOOK_KEYS={"revalidation-2026-08":"replace-with-at-least-32-random-bytes"}
REVALIDATION_ACTIVE_KEY_ID=revalidation-2026-08
REVALIDATION_AUDIENCE=amanor-public-web
PUBLIC_WEB_SERVICE_KEYS={"web-2026-08":"replace-with-at-least-32-random-bytes"}
PUBLIC_WEB_SERVICE_AUDIENCE=amanor-public-api
TRUST_PROXY_HOPS=0
RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RETENTION_CLOUD_NAME=
CLOUDINARY_RETENTION_API_KEY=
CLOUDINARY_RETENTION_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
PROTOCOL_DECISION_DERIVATION_KEY=
# Provider adapter endpoint. Configure all three values or none. The adapter
# accepts the bounded Project AMANOR event contract documented in operations.
CALENDAR_API_URL=
CALENDAR_API_TOKEN=
CALENDAR_ID=
PRESS_CONTACT_EMAIL=
GENERAL_CONTACT_EMAIL=
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# Set true only when the container security boundary requires Chromium without its own sandbox.
CHROME_NO_SANDBOX=false
# Private monitoring-network scrape credential; use at least 32 random bytes.
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
# Optional provider-neutral OTLP/HTTP trace endpoint. No request content or
# identity attributes are exported. Root traces default to 10% sampling.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
# Hardware-backed WebAuthn remains disabled until Security approves the RP,
# authenticator/attestation policy and custody drill. Origin must equal Admin.
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Project AMANOR Admin
WEBAUTHN_ORIGIN=http://localhost:3001
# Optional when NestJS terminates TLS directly; configure both or neither.
API_TLS_PRIVATE_KEY_PEM=
API_TLS_CERTIFICATE_PEM=
