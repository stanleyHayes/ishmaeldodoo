PUBLIC_INDEXING_ENABLED=false
# Production: https://ishmaelniidodoo.com with indexing enabled only after
# DNS/TLS, approved content and the production discoverability record pass.
LEAFLET_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
LEAFLET_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Public trust-anchor metadata compiled into the browser only when The Room is enabled.
