# Every .env variant is secret-bearing. Enumerating individual suffixes let
# .env.production through: it was neither ignored here nor scanned by
# check-secrets, because its extension is ".production".
.env
.env.*
!.env.example
.DS_Store
*.log
*.tsbuildinfo
tmp/
output/
artifacts/

# Local dev credentials — never commit
credentials.txt
